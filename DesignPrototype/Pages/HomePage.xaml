                        <!--  ТАБЛИЦА ПОЗИЦИЙ                                            -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#1E1E1E"
                                  RowBackground="#1E1E1E"
                                  AlternatingRowBackground="#252525"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#404040"
                                  VerticalGridLinesBrush="#404040"
                                  FontSize="12"
                                  FontFamily="Consolas"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Margin="10,0,10,0">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                    <Setter Property="Foreground" Value="#B0B0B0"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#404040"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Инструмент -->
                                <DataGridTextColumn Header="Инструмент" 
                                    Binding="{Binding Instrument}" 
                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Позиция -->
                                <DataGridTextColumn Header="Позиция" 
                                    Binding="{Binding Position}" 
                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Цена -->
                                <DataGridTextColumn Header="Цена" 
                                    Binding="{Binding Price}" 
                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Стоимость -->
                                <DataGridTextColumn Header="Стоимость" 
                                    Binding="{Binding Value}" 
                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Нереал. P/L -->
                                <DataGridTextColumn Header="Нереал. P/L" 
                                    Binding="{Binding UnrealizedPL}" 
                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- НПриб.% -->
                                <DataGridTextColumn Header="НПриб.%" 
                                    Binding="{Binding ProfitPercent}" 
                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- В покупке -->
                                <DataGridTextColumn Header="В покупке" 
                                    Binding="{Binding InBuy}" 
                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B0B0B0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- В продаже -->
                                <DataGridTextColumn Header="В продаже" 
                                    Binding="{Binding InSell}" 
                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B0B0B0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>

                            <!-- Стили строк (зелёные/красные) -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                            <Setter Property="Background" Value="#1B5E20"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                            <Setter Property="Background" Value="#B71C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!--  ФУТЕР: Итоговая панель (с Общей прибылью)                  -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Grid.Row="2" 
                                Background="#2A2A2A" 
                                BorderBrush="#404040"
                                BorderThickness="0,1,0,0"
                                Margin="10,5,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 🆕 Общая прибыль -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Свободно -->
                                <StackPanel Orientation="Horizontal" Margin="10,5">
                                    <TextBlock Text="Свободно: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="354,15" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Обеспечение -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,5">
                                    <TextBlock Text="Обеспечение: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="439,19" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Прибыль дня -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,5">
                                    <TextBlock Text="Прибыль дня: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="1,27" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- 🆕 ОБЩАЯ ПРИБЫЛЬ -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="15,5">
                                    <TextBlock Text="Общая прибыль: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="+4,520" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Прибыль % (сдвинут на колонку) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="15,5">
                                    <TextBlock Text="Прибыль %: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="0,29" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Деньги (сдвинут на колонку) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="15,5">
                                    <TextBlock Text="Деньги: " Foreground="#B0B0B0" FontSize="11"/>
                                    <TextBlock Text="8,33" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- РАЗДЕЛИТЕЛЬ -->
                <Border Grid.Column="1" Background="#404040" Margin="0,5"/>

                <!-- КОЛОНКА 1.2: 📅 Календарь -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="📅 Календарь" 
                                   FontSize="14" FontWeight="Bold" 
                                   Foreground="White"
                                   Margin="15,12,15,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="10,0,10,10">
                            <StackPanel>
                                <!-- Событие 1 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="14:30" Foreground="#90CAF9" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="CPI (Инфляция)" Foreground="White" FontSize="11"/>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#F44336" HorizontalAlignment="Center"/>
                                </Grid>
                                <!-- Событие 2 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="16:00" Foreground="#90CAF9" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="NFP (Занятость)" Foreground="White" FontSize="11"/>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#F44336" HorizontalAlignment="Center"/>
                                </Grid>
                                <!-- Событие 3 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="21:00" Foreground="#90CAF9" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="Fed Rate" Foreground="White" FontSize="11"/>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#FF9800" HorizontalAlignment="Center"/>
                                </Grid>
                                <!-- Событие 4 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="12:00" Foreground="#90CAF9" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="ВВП (ЕС)" Foreground="White" FontSize="11"/>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#FFC107" HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>
